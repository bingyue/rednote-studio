# Copy to .env. Keep secrets out of version control.
AI_MODE=mock
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
# Default is runtime/studio.db. For PostgreSQL use postgresql+psycopg://...
# DATABASE_URL=sqlite:////absolute/path/studio.db
# DATA_DIR=/absolute/path/runtime
# Optional shared local-workspace token. It is NOT per-user authentication.
STUDIO_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4174,http://localhost:4174,http://127.0.0.1:8088,http://localhost:8088
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
# Local profile CLI only; never a remote service
# REDNOTE_PROFILE_ROOT=/absolute/dedicated/profile-directory
